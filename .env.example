# Local development example; DO NOT copy directly to Railway production.
DATABASE_URL=postgresql://app_user:change-me@localhost:5432/b3_catalog
PORT=4000
NODE_ENV=development
ADMIN_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
ALLOWED_ORIGINS=

# For Railway (configure via private service variables):
# NODE_ENV=production
# ADMIN_ORIGIN=https://admin.example.com
# COOKIE_SECURE=true
# DATABASE_URL=<private Railway PostgreSQL connection reference>
# PORT is supplied by Railway; do not override.

# 32 cryptographically random bytes encoded as base64. Preserve this key after
# integrations are created; changing it without rotating credentials breaks decrypt.
INTEGRATION_MASTER_KEY=

# Keep real TU VERSO calls and WebSocket notifications disabled on first boot.
TUVERSO_LIVE_CHECKS_ENABLED=false
TUVERSO_LIVE_REQUESTS_ENABLED=false
B3_MOBILE_WS_ENABLED=false

# Optional, server-side only. Do not use VITE_ for secrets.
GOOGLE_ROUTES_API_KEY=

# Bootstrap is one-off only (never persist these in the web service):
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=<strong unique 14+ character secret>
