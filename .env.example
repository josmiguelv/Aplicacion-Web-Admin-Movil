DATABASE_URL=postgresql://app_user:change-me@localhost:5432/b3_catalog
PORT=4000
NODE_ENV=development
ADMIN_ORIGIN=http://localhost:3000
# For local HTTPS Cloudflare tunnel login only: add exact HTTPS origin, no trailing slash.
# Example: ALLOWED_ORIGINS=https://example.trycloudflare.com
# Never use *; production admin only trusts ADMIN_ORIGIN.
ALLOWED_ORIGINS=
# For HTTPS deployment set NODE_ENV=production, COOKIE_SECURE=true,
# and ADMIN_ORIGIN=https://your-admin-domain.
COOKIE_SECURE=false
# Bootstrap ONLY once, remove from deployment after running:
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-with-a-long-random-password
# Google Maps Routes API. Restricted server-side key; no live calls without it.
# Requires Google Cloud billing, Routes API enabled, API/IP restrictions and quota limits.
GOOGLE_ROUTES_API_KEY=
# Private server only: 32 random bytes encoded as canonical base64. Never use a VITE_ prefix.
INTEGRATION_MASTER_KEY=
# Default denies any real TU VERSO checks. Enable only with explicit credential/binding authorization.
TUVERSO_LIVE_CHECKS_ENABLED=false

# FCM push (solo servidor). OFF por defecto para evitar envíos durante las pruebas.
FCM_ENABLED=false
FCM_PROJECT_ID=pollosb3-84297
FCM_TARGET_APP_ID=com.integrab2g.pollosb3
FCM_TOPIC=pollosb3_promotions
# Origen HTTPS público y estable de la API, sin ruta y sin barra final.
FCM_PUBLIC_BASE_URL=
# Ruta absoluta a un JSON privado de CUENTA DE SERVICIO, no google-services.json.
# GOOGLE_APPLICATION_CREDENTIALS=C:\\Integra-B2G\\secrets\\pollosb3-service-account.json
# Alternativa exclusiva de secretos del servidor: FCM_SERVICE_ACCOUNT_JSON
# Nunca copiar claves a VITE_*, GitHub ni a Android.
