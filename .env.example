DATABASE_URL=postgresql://app_user:change-me@localhost:5432/b3_catalog
PORT=4000
NODE_ENV=development
ADMIN_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=
# For HTTPS deployment set NODE_ENV=production, COOKIE_SECURE=true,
# and ADMIN_ORIGIN=https://your-admin-domain.
COOKIE_SECURE=false
# Bootstrap ONLY once, remove from deployment after running:
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-with-a-long-random-password